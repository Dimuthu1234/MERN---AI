{
  "info": {
    "name": "Day 07 — MERN Tasks API",
    "_postman_id": "d07-mern-tasks-academydsj",
    "description": "Day 07 practical demo — Tasks CRUD on MongoDB. Set baseUrl variable in env or replace inline. After running 'Create task', taskId is auto-saved into the collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "taskId",  "value": "" }
  ],
  "item": [
    {
      "name": "API info",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
      }
    },
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "1. Create task",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json && (json.id || json._id)) {",
              "  pm.collectionVariables.set('taskId', json.id || json._id);",
              "}",
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('returns id', () => pm.expect(json.id || json._id).to.be.a('string'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Learn Mongoose\",\n  \"description\": \"Day 7 MERN session\",\n  \"priority\": \"high\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
      }
    },
    {
      "name": "2. List tasks",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
      }
    },
    {
      "name": "2b. List — only high priority",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/tasks?priority=high",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"],
          "query": [{ "key": "priority", "value": "high" }]
        }
      }
    },
    {
      "name": "3. Get one task",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        }
      }
    },
    {
      "name": "4. Mark task completed",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"completed\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        }
      }
    },
    {
      "name": "5. Delete task",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        }
      }
    },
    {
      "name": "Edge — Create with missing title (expect 400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"priority\": \"low\"\n}" },
        "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
      }
    },
    {
      "name": "Edge — Get with bad id (expect 400)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/tasks/not-a-real-id",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "not-a-real-id"]
        }
      }
    }
  ]
}
