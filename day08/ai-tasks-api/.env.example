# =========================================================
# Day 08 — AI Tasks API environment variables
# Copy this file to `.env` and fill in the real values.
# NEVER commit `.env` to git (it's in .gitignore).
# =========================================================

# --- Server ---
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB ---
# Option A — local Mongo:
MONGO_URI=mongodb://localhost:27017/day08tasks
# Option B — Atlas:
# MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/day08tasks?retryWrites=true&w=majority

# --- Anthropic Claude ---
# Get one from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-paste-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# Hard daily cost cap — refuses Claude calls if today's spend reaches this.
# Safety net: prevents a runaway loop costing $50 overnight.
DAILY_COST_CAP_USD=1.00
